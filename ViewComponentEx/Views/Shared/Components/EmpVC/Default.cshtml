@model Emp
<h2> Emp Info </h2>
<table>
    <tr>
     <td> Emp ID</td>
     <td> @Model.EmpID</td>
    </tr>
    <tr>
      <td> Emp Name </td>
      <td>@Model.EmpName</td>
    </tr>
    <tr>
        <td> Dept Name </td>
        <td>
            @Model.DeptName
        </td>
    </tr>
    <tr>
        <td> Salary </td>
        <td>
            @Model.Salary</td>
    </tr>
</table>
